# Required. The gateway refuses to start without a real key (>= 16 chars).
# Generate one with:  openssl rand -hex 32
# DOK reserves the SAKURA_ prefix; if the console rejects this name, use GATEWAY_API_KEY instead.
SAKURA_AI_API_KEY=replace-with-a-long-random-secret

OLLAMA_MODEL=gpt-oss:20b
# Context window Ollama allocates. Larger = more repo context but more VRAM.
OLLAMA_CONTEXT_LENGTH=32768

# The container exits after this many idle minutes, which ends the DOK task and
# stops per-second billing. 0 disables (you must then stop the task yourself).
IDLE_SHUTDOWN_MINUTES=60

# Cost estimation. DOK H100 list price is 0.28 yen/s = 1,008 yen/h incl. tax (2026-10).
GPU_YEN_PER_HOUR=1008
VOUCHER_YEN=100000

PORT=8080
